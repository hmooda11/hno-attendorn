{
  "name": "hno-praxis-attendorn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run validate:content && node scripts/build-sites.mjs",
    "build:pages": "npm run validate:content && vite build --outDir docs --emptyOutDir && node scripts/optimize-content-images.mjs docs",
    "build:vite": "npm run build:pages",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "vite": "^7.0.5",
    "yaml": "^2.9.0"
  }
}
